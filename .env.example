MONGODB_URI=
SSO_ORIGIN=https://sso.doneisbetter.com
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
APP_URL=https://deli.doneisbetter.com

# When enabled, the public deli storefront stays here while catalogue, orders and admin data are managed in Customer Direct.
CUSTOMER_DIRECT_MANAGED=0
CUSTOMER_DIRECT_STOREFRONT_ORIGIN=https://customerdirect.vercel.app
CUSTOMER_DIRECT_STOREFRONT_HOST=deli.doneisbetter.com
CUSTOMER_DIRECT_SHOP_PATH=deli_africa
CUSTOMER_DIRECT_REQUIRED=0
CUSTOMER_DIRECT_LOCALE=hu
CUSTOMER_DIRECT_CURRENCY=HUF

# Dedicated local/CI tests only; never use a live shop database.
CUSTOMER_DIRECT_TEST_DB=customer_direct_test_local
CUSTOMER_DIRECT_TEST_MONGODB_URI=mongodb://127.0.0.1:27119/?replicaSet=customerDirectTest
# Future platform credential envelopes; key values belong in secure environment settings.
CUSTOMER_DIRECT_ACTIVE_KEY_ID=
CUSTOMER_DIRECT_ENCRYPTION_KEYS=
