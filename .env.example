# deli.africa environment variables. Copy to .env.local (git-ignored) and fill values privately.
# Names only: never commit real values. Checked against the code on 2026-10-05; the app reads no other variables.
# Set by the platform, never by hand: NODE_ENV, VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, VERCEL_REGION,
# VERCEL_PROJECT_PRODUCTION_URL (read by /api/health) and CI (read by playwright.config.mjs).
# After changing production variables, trigger a new production deployment (README).

# --- Database (lib/db.js) ---
# MongoDB connection string. Optional: without it the storefront runs and accepts orders in demo mode (nothing is persisted).
MONGODB_URI=
# Alternative name for the same value, created by Vercel's MongoDB integration. MONGODB_URI wins when both are set.
deli_MONGODB_URI=

# --- DoneIsBetter SSO (lib/auth.js) ---
# SSO server origin. Optional: empty means https://sso.doneisbetter.com.
SSO_ORIGIN=
# OAuth client id. Required for login and the /dashboard admin (login is off unless id and secret are both set).
SSO_CLIENT_ID=
# OAuth client secret. Required with SSO_CLIENT_ID. Server-only; it also signs the session cookie.
SSO_CLIENT_SECRET=
# Public origin of this app, used to build the OAuth redirect URIs. Optional: empty means the request origin.
APP_URL=

# --- Provider credentials (lib/secret-store.js, app/api/site-settings/route.js) ---
# Key that encrypts provider credentials saved from the admin Integrations screen. Optional: falls back to SSO_CLIENT_SECRET.
SETTINGS_ENCRYPTION_KEY=
# Optional. Only read to report provider readiness in /api/site-settings; saved credentials normally live in the database.
PACKETA_API_KEY=
BARION_POS_KEY=
BILLINGO_API_KEY=

# --- Customer Direct managed mode (lib/customer-direct-store.js, lib/managed-admin.js) ---
# Managed mode is ON when CUSTOMER_DIRECT_MANAGED is 1, true, yes or on, OR when STOREFRONT_ORIGIN and STOREFRONT_HOST are both set,
# even if CUSTOMER_DIRECT_MANAGED is 0. For standalone mode leave all three empty. When on, the catalogue, site settings and orders
# come from Customer Direct, /dashboard redirects there and the admin APIs answer 410. Optional, off when empty.
CUSTOMER_DIRECT_MANAGED=
# Customer Direct origin (production: https://customerdirect.vercel.app, per README). Used for storefront calls, media proxy and the admin link.
CUSTOMER_DIRECT_STOREFRONT_ORIGIN=
# Public host of this shop as registered in Customer Direct (production: deli.doneisbetter.com); sent as x-customer-direct-host.
CUSTOMER_DIRECT_STOREFRONT_HOST=
# Fallback for CUSTOMER_DIRECT_STOREFRONT_HOST when that is empty. Optional.
NEXT_PUBLIC_SITE_HOST=
# Shop path in Customer Direct for the admin link and media proxy. Optional: empty means deli_africa.
CUSTOMER_DIRECT_SHOP_PATH=
# 1 raises Customer Direct request failures instead of falling back to local data. Optional, off when empty; intended after cutover.
CUSTOMER_DIRECT_REQUIRED=
# Locale and currency requested for the catalogue. Optional: empty means hu and HUF.
CUSTOMER_DIRECT_LOCALE=
CUSTOMER_DIRECT_CURRENCY=

# --- Platform credential envelopes (lib/platform/secrets.mjs) ---
# Foundation module, not used by any route yet (covered by tests/platform-secrets.test.mjs). Key values belong in secure environment settings.
CUSTOMER_DIRECT_ACTIVE_KEY_ID=
# JSON object mapping each key id to a base64-encoded 32-byte key.
CUSTOMER_DIRECT_ENCRYPTION_KEYS=

# --- Tests only (scripts/test-environment.mjs, pnpm test:integration) ---
# Dedicated local/CI test database; never use a live shop database. The name must match customer_direct_test_[a-z0-9_]+.
CUSTOMER_DIRECT_TEST_DB=customer_direct_test_local
CUSTOMER_DIRECT_TEST_MONGODB_URI=mongodb://127.0.0.1:27119/?replicaSet=customerDirectTest
# Optional production database names; the test run refuses a test database that matches any of them.
MONGODB_DB=
MONGODB_DB_NAME=
PLATFORM_DATABASE_NAME=
